<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_cinema"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/brand_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="88dp"
        android:layout_marginTop="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:contentDescription="@null"
            android:src="@drawable/app_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:focusable="false"
            android:text="飞牛相册"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_server_select"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="92dp"
        android:paddingTop="136dp"
        android:paddingEnd="92dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_select_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="选择照片服务器"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="18dp"
                android:indeterminate="true" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="238dp"
            android:layout_marginTop="42dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/server_list"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:focusable="false"
            android:text="正在搜索局域网内的飞牛服务器"
            android:textColor="#B8C0CC"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_connecting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:text="正在连接服务器"
            android:textColor="#F3F5F8"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="720dp"
            android:layout_height="220dp"
            android:layout_marginTop="66dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_login_card_soft"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="80dp"
                android:layout_marginEnd="80dp"
                android:indeterminate="true" />

            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_login_card_soft"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_connect_server_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="飞牛服务器"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_connect_server_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="#AAB2BF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="116dp"
        android:paddingTop="42dp"
        android:paddingEnd="88dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_current_server_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="飞牛服务器"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_current_server_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:focusable="false"
                android:textColor="#AAB2BF"
                android:textSize="21sp" />

            <Button
                android:id="@+id/btn_switch_server"
                android:layout_width="168dp"
                android:layout_height="50dp"
                android:layout_marginStart="34dp"
                android:background="@drawable/bg_login_button"
                android:text="切换服务器"
                android:textAllCaps="false"
                android:textColor="@color/login_button_text"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="142dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_login_card_soft"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tab_qr_login"
                android:layout_width="132dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_login_pill"
                android:focusable="true"
                android:gravity="center"
                android:text="扫码登录"
                android:textColor="#111318"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tab_account_login"
                android:layout_width="132dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_login_pill"
                android:focusable="true"
                android:gravity="center"
                android:text="账号登录"
                android:textColor="#111318"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/qr_login_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="52dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:text="可扫码登录"
                        android:textColor="#F3F5F8"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="470dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="36dp"
                        android:focusable="false"
                        android:lineSpacingExtra="8dp"
                        android:text="飞牛 App → 头像 → 扫码"
                        android:textColor="#D5DAE2"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_qr_status"
                        android:layout_width="470dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:focusable="false"
                        android:text="正在生成二维码"
                        android:textColor="#AAB2BF"
                        android:textSize="16sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="340dp"
                    android:layout_height="340dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_qr_holder"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/img_qr_code"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/progress_qr"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:indeterminate="true" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/account_login_body"
                android:layout_width="520dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_login_card_soft"
                android:orientation="vertical"
                android:padding="28dp">

                <EditText
                    android:id="@+id/edit_username"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="用户名"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:singleLine="true"
                    android:textColor="#111318"
                    android:textColorHint="#7A7F88"
                    android:textCursorDrawable="@drawable/cursor_blue"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/edit_api_token"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="密码"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:singleLine="true"
                    android:textColor="#111318"
                    android:textColorHint="#7A7F88"
                    android:textCursorDrawable="@drawable/cursor_blue"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_totp_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:focusable="false"
                    android:text="请输入 6 位动态验证码"
                    android:textColor="#D5DAE2"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/edit_totp_code"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    android:digits="0123456789"
                    android:hint="动态验证码"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="6"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:singleLine="true"
                    android:textColor="#111318"
                    android:textColorHint="#7A7F88"
                    android:textCursorDrawable="@drawable/cursor_blue"
                    android:textSize="17sp"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/cb_trust_device"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:buttonTint="#6ECFC1"
                    android:checked="false"
                    android:text="信任此设备"
                    android:textColor="#D5DAE2"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/account_options_row"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cb_remember"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="记住登录信息"
                        android:textColor="#D5DAE2"
                        android:textSize="15sp" />

                    <CheckBox
                        android:id="@+id/cb_disclaimer_agree"
                        android:layout_width="38dp"
                        android:layout_height="44dp"
                        android:buttonTint="#6ECFC1"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_disclaimer_agreement"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:text="@string/disclaimer_agreement"
                        android:textColor="#D5DAE2"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_login_button"
                    android:text="登录"
                    android:textAllCaps="false"
                    android:textColor="@color/login_button_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/manual_add_panel"
        android:layout_width="680dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_login_modal"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:text="添加服务器"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_nas_url"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_login_input"
            android:hint="服务器地址，如 nas.local:5666"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="#111318"
            android:textColorHint="#7A7F88"
            android:textCursorDrawable="@drawable/cursor_blue"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_manual"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_login_button"
                android:text="取消"
                android:textAllCaps="false"
                android:textColor="@color/login_button_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_manual_connect"
                android:layout_width="150dp"
                android:layout_height="50dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_login_button"
                android:text="连接"
                android:textAllCaps="false"
                android:textColor="@color/login_button_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/disclaimer_dialog"
        android:layout_width="780dp"
        android:layout_height="620dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_login_modal"
        android:elevation="24dp"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:text="免责声明"
            android:textColor="#FFFFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/disclaimer_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:focusable="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbarStyle="insideInset">

            <TextView
                android:id="@+id/tv_disclaimer_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:lineSpacingExtra="6dp"
                android:text="@string/disclaimer_content"
                android:textColor="#D5DAE2"
                android:textSize="16sp" />
        </ScrollView>

        <Button
            android:id="@+id/btn_close_disclaimer"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_gravity="end"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_login_button"
            android:text="关闭"
            android:textAllCaps="false"
            android:textColor="@color/login_button_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
