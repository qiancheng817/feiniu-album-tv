<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/tv_card_corner" />
            <solid android:color="@color/contact_sheet_raised" />
            <stroke
                android:width="@dimen/tv_focus_ring"
                android:color="@color/focus_glow" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/tv_card_corner" />
            <solid android:color="@color/transparent" />
        </shape>
    </item>
</selector>
