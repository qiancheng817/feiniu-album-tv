<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#F024231F" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_mint" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#D924231F" />
            <stroke
                android:width="1dp"
                android:color="#338A8276" />
        </shape>
    </item>
</selector>
